{
  "name": "tracemind",
  "version": "0.1.0",
  "description": "Trace your coding agents and see what they knew. Local first, with an optional shared server.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tracemind": "dist/src/cli/index.js"
  },
  "files": [
    "dist/src",
    "dist/web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "node --experimental-strip-types src/cli/index.ts",
    "dev:web": "vite",
    "record": "pnpm build && node scripts/record.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "^4.7.0",
    "postgres": "^3.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "gifenc": "^1.0.3",
    "lucide-react": "^1.79.0",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^3.2.0"
  }
}
